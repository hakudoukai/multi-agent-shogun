[Unit]
Description=Enter Restart — shogun-main Watchdog (横展開 main_pc, 10min idle → C-m only, label-match strict)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h
# ★main_pc は doppler が ~/.local/bin/doppler ゆえ PATH を明示 (副院長令 baabd1ca 横展開)★
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# ExecStartPre で log dir を保証 (cycle3 B2 同型対策)
ExecStartPre=/bin/mkdir -p %h/.local/share/enter_restart_shogun_main
ExecStart=/bin/bash %h/projects/multi-agent-shogun-newbuild/scripts/watchdogs/enter_restart_shogun_main_watchdog.sh
StandardOutput=append:%h/.local/share/enter_restart_shogun_main/service.log
StandardError=append:%h/.local/share/enter_restart_shogun_main/service.err
