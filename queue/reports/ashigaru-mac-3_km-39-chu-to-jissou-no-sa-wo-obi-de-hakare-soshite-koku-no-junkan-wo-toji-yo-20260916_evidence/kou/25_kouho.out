【裁く材】 生きた本の候補 = ★18 本★(控 24 本は写しゆゑ除いた ―― ★歩いては居る★)
  刷るは 註の行 + 其の後 12 行。★裁は此処に書かぬ。紙に書く。★

══ scripts/checks/ephemeral_worktree_hygiene.sh:12 ══
  註→ L12   | # 読まれなく成る(= 常に鳴る 検 は 鳴らぬ 検 と 同じ)。
      L13   | # ⑴掃ける= 中身 が commit 済(porcelain 0)★かつ★ 24 時 触られて 居らぬ
      L14   | # ⑵持主 の言 が要る= 中身 が在る(未追跡/変更)
      L15   | # ⑶生きて 居る= 24 時 以内 に触られた
      L16   | SWEEPABLE=0; OWNED=0; LIVE=0
      L17   | for d in "${WT_DIR}"/tmp-*; do
      L18   |   [ -d "${d}" ] || continue
      L19   |   dirty="$(git -C "${d}" status --porcelain 2>/dev/null | wc -l | tr -d ' ')"
      L20   |   recent="$(find "${d}" -maxdepth 0 -newermt '-24 hours' 2>/dev/null | wc -l | tr -d ' ')"
      L21   |   if [ "${dirty}" != "0" ]; then OWNED=$((OWNED+1))
      L22   |   elif [ "${recent}" != "0" ]; then LIVE=$((LIVE+1))
      L23   |   else SWEEPABLE=$((SWEEPABLE+1)); fi
      L24   | done

══ scripts/checks/karo_mac_dasumae_gate.sh:42 ══
  註→ L42   |   #   ★偽の青は作れぬ★ ―― 條②を隠す紙は必ず條③を鳴らす故、此の疵は「數を少なく言ふ」疵である。
