      L54   |   cr_n=$(grep -c $'\r' "$f" 2>/dev/null); cr_rc=$?

══ scripts/checks/karo_mac_gate4.sh:61 ══
  註→ L61   | #       ⑷ の裁= ★file 種 で分けず byte 一律 の閾 で見る★(97.5% が .log/.md ゆゑ 種 別 は要らぬ)。
      L62   | #     ★此の閾 は 上記 の実測 から引いた物 で あり、母數 が変れば 引き直せ。★
      L63   | MAXF="${GATE4_MAX_FILE_MB:-50}"; MAXT="${GATE4_MAX_TOTAL_MB:-100}"
      L64   | big=0; total=0
      L65   | while IFS= read -r f; do
      L66   |   [ -f "$f" ] || continue
      L67   |   sz=$(wc -c < "$f" | tr -d ' ')
      L68   |   total=$((total + sz))
      L69   |   mb=$((sz / 1048576))
      L70   |   if [ "$mb" -ge "$MAXF" ]; then say "★條⑤ 単 file が ${mb} MB(上限 ${MAXF})―― ${f}★"; big=1; fi
      L71   | done < <(git diff --cached --name-only -- "$@")
      L72   | tmb=$((total / 1048576))
      L73   | if [ "$big" -ne 0 ] || [ "$tmb" -ge "$MAXT" ]; then

