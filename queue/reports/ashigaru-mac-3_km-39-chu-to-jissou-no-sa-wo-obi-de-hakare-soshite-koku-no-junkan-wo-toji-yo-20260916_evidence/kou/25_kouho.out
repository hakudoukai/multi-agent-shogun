      L78   |     # タイムアウト(55秒)でexit 0 → ループは有限回で終了
      L79   |     WATCH_TARGETS_ACTIVE=("$INBOX")
      L80   |     if [ "$AGENT_ID" = "shogun" ]; then
      L81   |         WATCH_TARGETS_ACTIVE+=("$SCRIPT_DIR/dashboard.md")
      L82   |     fi
      L83   |     # timeout: 55→10 (副院長令83d84fa0 / Commander seq30274 — turn終端応答性回復)

