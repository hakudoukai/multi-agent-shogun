      L72   |     # ALWAYS create the idle flag so inbox_watcher knows the agent is idle
      L73   |     # and can send nudges. Previously, removing the flag here when unread > 0
      L74   |     # caused a deadlock: agent idle but watcher thinks busy → no nudge → stuck.
      L75   |     FLAG="${IDLE_FLAG_DIR:-/tmp}/shogun_idle_${AGENT_ID}"
      L76   |     touch "$FLAG"
