import os
bad=[]
for dp,dn,fn in os.walk('docs/evidence/km-49-buzai-shikii-20260917'):
    for f in fn:
        p=os.path.join(dp,f)
        if p.endswith('.nul'): continue
        b=open(p,'rb').read()
        if not b.endswith(b'\n') or b.endswith(b'\n\n') or b'\r' in b: bad.append(p)
