import hashlib,io
for l in io.open('$B/10_buzai_mon.sh',encoding='utf-8'):
    if l.startswith('is_num(){'): print('sha16(改行含めず)=',hashlib.sha256(l.rstrip('\n').encode()).hexdigest()[:16]) 外の器    引けぬ      引けぬ
     1
import os
bad=[]
for dp,dn,fn in os.walk('$D'):
    for f in fn:
        p=os.path.join(dp,f)
        if p.endswith('.nul'): continue
        b=open(p,'rb').read()
        if not b.endswith(b'\n') or b.endswith(b'\n\n') or b'\r' in b: bad.append(p)
print('  違反 =',len(bad)); [print('   ',x) for x in bad] 外の器    引けぬ      引けぬ
