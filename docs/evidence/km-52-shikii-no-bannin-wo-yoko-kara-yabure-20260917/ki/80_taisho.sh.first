#!/usr/bin/env bash
# 80 — ★陽性対照(敵形が鳴る)・陰性対照(清形が黙る)★(㋔)
#   番人の逐語(guard_inbox_watcher.sh を写しから引く)を其の儘走らせ、鳴/黙 と 受/倒 を見る。
set -u
G="$(dirname "$0")/guard_inbox_watcher.sh"
# 写しから num_same_op..fix_threshold と _th_say を取り出す(頭〜fix_threshold 閉ぢ迄)
_th_say(){ printf '[watcher] %s\n' "$*" >&2; }
num_same_op(){ [ "${1:-}" -ge 0 ] 2>/dev/null; [ $? -le 1 ]; }
env_state(){
  eval "_es_set=\"\${$1+set}\"; _es_v=\"\${$1-}\""
  if [ -z "${_es_set}" ]; then printf 'unset\n'
  elif [ -z "${_es_v}" ]; then printf 'empty\n'
  elif [ -z "$(printf '%s' "${_es_v}" | tr -d '[:space:]')" ]; then printf 'blank\n'
  else printf 'value\n'; fi
}
fix_threshold(){
  _ft_n="$1"; _ft_d="$2"; _ft_o="$3"; _ft_s="$(env_state "$_ft_n")"; eval "_ft_v=\"\${$_ft_n-}\""
  case "$_ft_s" in
    unset) eval "$_ft_o=\$_ft_d"; return 0 ;;
    empty) _th_say "★閾 ${_ft_n} が空文字 ―― 既定 ${_ft_d} へ倒す(fail-closed)★"; eval "$_ft_o=\$_ft_d"; return 0 ;;
    blank) _th_say "★閾 ${_ft_n} が空白のみ ―― 既定 ${_ft_d} へ倒す(fail-closed)★"; eval "$_ft_o=\$_ft_d"; return 0 ;;
  esac
  if num_same_op "$_ft_v" && [ "$_ft_v" -ge 0 ]; then eval "$_ft_o=\$_ft_v"; return 0; fi
  _th_say "★閾 ${_ft_n} を比較器が扱へぬ(「${_ft_v}」) ―― 既定 ${_ft_d} へ倒す(fail-closed)★"
  eval "$_ft_o=\$_ft_d"
}
trial(){  # $1=札 $2=環境値(UNSET なら unset) $3=期待
  unset T; [ "$2" != "__UNSET__" ] && T="$2"
  nari="$( { fix_threshold T 30 OUT; } 2>&1 1>/dev/null )"
  printf '%-22s 値=%-12q 受=%-4s 鳴=%s\t期待:%s\n' "$1" "$2" "${OUT:-?}" \
    "$([ -n "$nari" ] && echo 有 || echo 黙)" "$3"
}
echo "=== ★陽性対照★: 敵形は必ず鳴り、既定30へ倒れる ==="
trial "空文字(㋐02)"    ""       "鳴・倒30"
trial "空白のみ(㋐05)"  "   "    "鳴・倒30"
trial "負(㋐06)"        "-1"     "鳴・倒30(ab2a1f1 で塞ぐ)"
trial "非数(㋐13全角)"   "５０"   "鳴・倒30"
trial "改行注入(㋐12)"  "$(printf '50\n9999')" "鳴・倒30・但し鳴りが二行(注入)"
echo "=== ★陰性対照★: 清形は黙り、値を受ける ==="
trial "清数(30)"        "30"     "黙・受30"
trial "清数(120)"       "120"    "黙・受120"
echo "=== ★設計上の黙り★: 未設定は高頻度器では黙る(乙′) ==="
trial "未設定(㋐01)"    "__UNSET__" "黙・倒30(設計常態)"
