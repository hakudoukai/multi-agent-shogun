# -*- coding: utf-8 -*-
"""70 紙⇔器 の照合(第79弾 km-86・km-84 の写し)―― 紙(README.md)に書いた數を、器の出目(raw/*.txt)から regex で抽いた數と突き合はせる。
一件= (札, 紙の regex, 器の file, 器の regex)。紙側は ★全ての当たりが同じ値★ でなければ ×(同じ數を二度違へて書く事を封じる)。rc 0= 悉く ○。己(70)の出目は照合の外(循環)。"""
import sys, re, time
D = sys.argv[1]; sys.path.insert(0, D + '/raw'); import kaki as K
P = open(D + '/README.md', encoding='utf-8').read(); T = {n: open(D + f'/raw/{n}.txt', encoding='utf-8').read() for n in ('00_start', '01_letter', '10_kuchi', '20_shimo', '30_tally', '40_taishou', '35_naoshi')}
C = [
 ('札 sha16', r'sha16 (ee8467d11659a0b5) 74 行', '00_start', r'sha16 (\S+) \d+行'), ('札 行', r'sha16 ee8467d11659a0b5 (\d+) 行', '00_start', r'sha16 \S+ (\d+)行'), ('HEAD', r'凍結点 HEAD (\S+) /', '00_start', r'HEAD (\S+) /'),
 ('根A', r'= ★(\d+) 本★\(shell 114', '00_start', r'を除き ★(\d+) 本★'), ('根A shell', r'★169 本★\(shell (\d+) / python', '00_start', r'★169 本★\(shell (\d+) /'), ('根A python', r'★169 本★\(shell 114 / python (\d+)\)', '00_start', r'★169 本★\(shell \d+ / python (\d+)\)'),
