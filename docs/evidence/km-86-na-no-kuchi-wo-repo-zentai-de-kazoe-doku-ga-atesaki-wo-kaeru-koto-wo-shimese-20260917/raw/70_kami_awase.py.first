 ('名 sub path', r'既定が path (\d+) / 既定が語 102 / 讀手', '10_kuchi', r'名:既定が path (\d+)'), ('名 sub 語', r'既定が path 44 / 既定が語 (\d+) / 讀手', '10_kuchi', r'名:既定が語 (\d+)'), ('KEY', r'末尾 KEY (\d+)・URL', '10_kuchi', r'名:語\(末尾 KEY\) (\d+)'), ('URL', r'KEY 54・URL (\d+)・ID', '10_kuchi', r'名:語\(末尾 URL\) (\d+)'),
 ('組', r'名 308 口 = \(file,名\) (\d+) 組', '20_shimo', r'\(file,名\) (\d+) 組'), ('参照行', r'参照行 (\d+)\(註を除く・派生', '20_shimo', r'参照行 (\d+)\(註'), ('派生', r'註を除く・派生 (\d+)・別名', '20_shimo', r'派生の行 (\d+)・'), ('別名', r'派生 104・別名 (\d+)\)', '20_shimo', r'別名 (\d+)\)'),
 ('同file 害', r'同 file の害の行 (\d+) = ⑴', '20_shimo', r'＝ 害の行 (\d+)★'), ('⑴', r'⑴ tmux target (\d+) / ⑵ session 名 0 / ⑶', '20_shimo', r'同 file・行\): ⑴ tmux target (\d+)'), ('⑵', r'⑵ session 名 (\d+) / ⑶ path・dir・file 219', '20_shimo', r'/ ⑵ session 名 (\d+) /'), ('⑶', r'⑶ path・dir・file (\d+) / ⑷ topic・宛先 role 28', '20_shimo', r'/ ⑶ path・dir・file (\d+) /'), ('⑷', r'⑷ topic・宛先 role (\d+) / ⑸ 比較 37', '20_shimo', r'/ ⑷ topic・宛先 role (\d+) /'), ('⑸', r'⑸ 比較 (\d+)、讀まぬ', '20_shimo', r'/ ⑸ 比較 (\d+) ＝'),
 ('數', r'讀まぬ参照= 數 (\d+)・伝', '20_shimo', r'／ 數 (\d+) / 伝'), ('伝', r'數 1・伝 (\d+)・口', '20_shimo', r'/ 伝 (\d+) / 口'), ('口 262', r'伝 136・口 (\d+)・他', '20_shimo', r'/ 口 (\d+) / 他'), ('他', r'口 262・他 (\d+)。', '20_shimo', r'/ 他 (\d+) ／'),
 ('他file', r'★他 file の讀手 (\d+) 行\(組', '20_shimo', r'／ 數 0 ＝ (\d+)★'), ('他file 組', r'361 行\(組 (\d+)\)', '20_shimo', r'他file の讀手 行 \d+\(組 (\d+)\)'), ('他 ⑴', r'\(組 85\)= ⑴ (\d+) /', '20_shimo', r'他file・行\): ⑴ (\d+)'), ('他 ⑵', r'= ⑴ 16 / ⑵ (\d+) / ⑶ 229', '20_shimo', r'他file・行\): ⑴ \d+ / ⑵ (\d+)'), ('他 ⑶', r'⑵ 4 / ⑶ (\d+) / ⑷ 66', '20_shimo', r'他file・行\): ⑴ \d+ / ⑵ \d+ / ⑶ (\d+)'), ('他 ⑷', r'⑶ 229 / ⑷ (\d+) / ⑸ 46', '20_shimo', r'他file・行\): .*? / ⑷ (\d+) /'), ('他 ⑸', r'⑷ 66 / ⑸ (\d+)★\(ER_PANE', '20_shimo', r'他file・行\): .*? / ⑸ (\d+) /'),
 ('排他', r'一行に二類が当たつた行 (\d+)\(優先順', '20_shimo', r'当たつた行 = (\d+)\('), ('讀まれぬ', r'讀まれぬ口\(同 file にも他 file にも参照 0\)= (\d+) 組', '20_shimo', r'参照 0\)= (\d+) 組'), ('同名別口', r'同名の別口\(他言語・python が己の口で受ける\)のみ (\d+) 組', '20_shimo', r'同名の別口\(他言語\)のみ (\d+)'),
 ('組 他file', r'他 file で讀む (\d+) / ⑶ 61', '20_shimo', r'他file で讀む (\d+) /'), ('組 ⑶', r'他 file で讀む 85 / ⑶ (\d+) /', '20_shimo', r'/ ⑶ (\d+) / ★讀まれぬ'), ('組 伝他', r'伝・他のみ (\d+) / ⑸ 12', '20_shimo', r'伝/他のみ (\d+) /'), ('組 ⑸', r'伝・他のみ 15 / ⑸ (\d+) /', '20_shimo', r'/ ⑸ (\d+) / ⑷ 8'), ('組 ⑷', r'⑸ 12 / ⑷ (\d+) / ⑷\+⑶ 3', '20_shimo', r'/ ⑷ (\d+) / ⑷\+⑶'),
 ('scope_out 同', r'同 file の害 (\d+) 行= detect_stale', '20_shimo', r'= 同file (\d+) 行'), ('scope_out 他', r'他 file 経由 (\d+) 行\)。毒当て', '20_shimo', r'他file 経由 (\d+) 行'),
 ('30 母', r'害の讀手 (\d+) 行 → scope_out 除外 18', '30_tally', r'類⑴〜⑸\) (\d+) 行'), ('30 除外', r'scope_out 除外 (\d+)\(專任2', '30_tally', r'scope_out 除外 (\d+) /'), ('30 件', r'重複を畳んで (\d+) 件', '30_tally', r'重複を畳んで (\d+) 件'), ('写せた', r'写せた (\d+)\(⑴ 10 / ⑵ 3', '30_tally', r'写せた (\d+)\('), ('写せぬ', r'写せぬ (\d+)\(`\$\(…\)` を含む語 18', '30_tally', r'写せぬ (\d+) /'),
 ('写 ⑴', r'写せた 544\(⑴ (\d+) / ⑵', '30_tally', r'写せた \d+\(⑴ (\d+)'), ('写 ⑵', r'⑴ 10 / ⑵ (\d+) / ⑶ 402', '30_tally', r'⑴ \d+ ⑵ (\d+) ⑶'), ('写 ⑶', r'⑵ 3 / ⑶ (\d+) / ⑷ 89', '30_tally', r'⑵ \d+ ⑶ (\d+) ⑷'), ('写 ⑷', r'⑶ 402 / ⑷ (\d+) / ⑸ 40\)', '30_tally', r'⑶ \d+ ⑷ (\d+) ⑸'), ('写 ⑸', r'⑷ 89 / ⑸ (\d+)\)/ 写せぬ', '30_tally', r'⑷ \d+ ⑸ (\d+)\)/'),
 ('写せぬ 語', r'`\$\(…\)` を含む語 (\d+)・case', '30_tally', r'写せぬ\(\$\(…\) を含む語\) (\d+)'), ('写せぬ case', r'・case (\d+)・python', '30_tally', r'写せぬ\(case\) (\d+)'), ('写せぬ py', r'代入形でない (\d+)・写しが壊れた', '30_tally', r'代入形でない\) (\d+)'), ('写せぬ bash -n', r'bash -n (\d+)・別名', '30_tally', r'bash -n\) (\d+)'), ('写せぬ 別名', r'別名の行に `\$\(…\)` (\d+)\)', '30_tally', r'別名の行に \$\(…\)\) (\d+)'),
 ('走', r'毒 10 × 544 = (\d+) 走', '30_tally', r'= (\d+) 走\(\+'), ('報せ 0', r'器の報せ (\d)・外の声 0・★黙つて', '30_tally', r'器の報せ>0 (\d+) /'), ('声 0', r'器の報せ 0・外の声 (\d)・★黙つて', '30_tally', r'外の声>0 (\d+) /'), ('黙つて変', r'黙つて向先が変はつた (\d+)★', '30_tally', r'素通し or 別形\)(\d+)★'), ('既定へ', r'黙つて既定へ落ちた (\d+)★', '30_tally', r'黙つて既定へ落ちた (\d+) /'),
 ('⑶ 空 既定', r'空文字は ⑶ で 402 走の内 既定へ (\d+)・素通し', '30_tally', r'⑶ 空文字\t走 \d+\t素通し \d+\t既定へ (\d+)'), ('⑶ 空 素通し', r'既定へ 317・素通し (\d+)\(向先= 空文字', '30_tally', r'⑶ 空文字\t走 \d+\t素通し (\d+)'), ('⑶ 空 別形', r'`cat ""` の形\)・別形 (\d+)。', '30_tally', r'⑶ 空文字\t走 \d+\t素通し \d+\t既定へ \d+\t★別形★ (\d+)'),
 ('⑶ .. 上へ', r'⑴ 10 ⑵ 3 ⑶ (\d+) ⑷ 87 ⑸ 36\)・絶対', '30_tally', r'⑶ \.\.入り\t.*?上へ (\d+)'), ('⑷ .. 上へ', r'⑶ 401 ⑷ (\d+) ⑸ 36\)・絶対', '30_tally', r'⑷ \.\.入り\t.*?上へ (\d+)'), ('⑶ 絶対 根', r'根が変はる 386 走\(⑴ 10 ⑵ 3 ⑶ (\d+) ⑷ 68', '30_tally', r'⑶ 絶対path\t.*?根が変はる (\d+)'), ('⑷ 絶対 根', r'⑶ 269 ⑷ (\d+) ⑸ 36\)・★', '30_tally', r'⑷ 絶対path\t.*?根が変はる (\d+)'), ('⑸ 絶対 根', r'⑶ 269 ⑷ 68 ⑸ (\d+)\)・★', '30_tally', r'⑸ 絶対path\t.*?根が変はる (\d+)'), ('実行 0', r'`\$\(…\)` 入りが実行された走 (\d+)★', '30_tally', r'⑶ \$\(…\)入り\t.*?★実行された★ (\d+)'),
 ('⑷ 空 既定', r'\| ⑷ \| 89 \| 既定へ (\d+)・素通し 56', '30_tally', r'⑷ 空文字\t走 \d+\t素通し \d+\t既定へ (\d+)'), ('⑸ 空 既定', r'\| ⑸ \| 40 \| 既定へ (\d+)・素通し 1', '30_tally', r'⑸ 空文字\t走 \d+\t素通し \d+\t既定へ (\d+)'), ('⑶ 空白のみ', r'\| ⑶ \| 402 \| 既定へ 317・素通し 83・別形 2 \| 素通し (\d+)・別形 20', '30_tally', r'⑶ 空白のみ\t走 \d+\t素通し (\d+)'),
 ('対照 ○', r'判 通 ○ (\d)/9', '40_taishou', r'○=(\d)/'), ('対照 母', r'判 通 ○ 9/(\d)', '40_taishou', r'○=\d/(\d)'), ('対照 走', r'○ 9/9・走 (\d+)・刻', '40_taishou', r'/ 走 (\d+) /'),
 ('A 偽陽性', r'A 空を拒む\(`:\?`・空なら止まる\) \| 空文字 \| 他 9 \| (\d+)/130', '35_naoshi', r'扱ふ口 ★(\d+)★'), ('A 母', r'\| (\d+)\(同 file が -z/-n', '35_naoshi', r'既定が空の名の口 (\d+) の内'), ('B 偽陽性', r'\| (\d+)/44\(既定が /tmp', '35_naoshi', r'指す口 ★(\d+)★'), ('B 母', r'\| 37/(\d+)\(既定が /tmp', '35_naoshi', r'既定が path の口 (\d+) の内'), ('C 偽陽性', r'\| (\d)\(PERMISSION_FLAG', '35_naoshi', r'含む口 ★(\d+)★'), ('C 空白', r'空白を禁に入れれば \+(\d) \|', '35_naoshi', r'空白を含む既定 (\d+)\('), ('D 慣行', r'慣行 (\d+)/17 行', '35_naoshi', r'検めが在る ★(\d+)★ 行'), ('D 母', r'慣行 8/(\d+) 行', '35_naoshi', r'⑴ の讀手 (\d+) 行の内'), ('E 死箱', r'★(\d)/5・4/5★= 宣の腐り', '35_naoshi', r'在らぬ ★(\d+)/\d+★\(之は'), ('E registry', r'★5/5・(\d)/5★= 宣の腐り', '35_naoshi', r'当たると 在らぬ ★(\d+)/\d+★:'), ('E 直呼び', r'直呼び (\d+) 行の内 ★shogun', '35_naoshi', r'第一引数\(字面・根A\)= (\d+) 行'),
 ('疵 數', r'㋖ 疵 (\d+)\(㊈\)', 'README', r'^- ★?疵'),
]
rows = []; ng = 0
for label, pr, tf, tr in C:
    if tf == 'README': kami = re.findall(pr, P); utsu = [str(len(re.findall(tr, P, re.M)))]
    else: kami = re.findall(pr, P); utsu = re.findall(tr, T[tf], re.S)
    ok = bool(kami) and bool(utsu) and len(set(kami)) == 1 and kami[0] == utsu[0]
    ng += (not ok); rows.append(('○' if ok else '×', label, '/'.join(kami) or '(紙に無)', utsu[0] if utsu else '(器に無)', tf, len(kami)))
out = [f'# 70 紙⇔器 の照合 / 刻 {time.strftime("%Y-%m-%dT%H:%M:%S%z")} / 母數 {len(C)} / ○ {len(C) - ng} / × {ng} / rc {1 if ng else 0}', '判\t札\t紙の値(当たり全て同値か)\t器の値\t器\t紙の当たり數'] + ['\t'.join(str(x) for x in r) for r in rows]
K.kaku(D + '/raw/70_kami_awase.txt', '\n'.join(out)); print('\n'.join(out)); sys.exit(1 if ng else 0)
