 ('着手便 id', r'着手便 (msg_20260917_112650_99c9b6f1)', '01_letter', r"\('(msg_\S+)', '"), ('着手便 刻', r'着手便 msg_\S+\((\d\d:\d\d:\d\d)', '01_letter', r"', '\S+T(\d\d:\d\d:\d\d)'\)"),
 ('口', r'の口 (\d+)\(km-84 の 493 と一致', '10_kuchi', r'★母數= 口 (\d+)\('), ('閾', r'★閾 (\d+) / 旗 25 / 名 308', '10_kuchi', r'閾 (\d+) / 旗'), ('旗', r'閾 89 / 旗 (\d+) / 名 308', '10_kuchi', r'/ 旗 (\d+) / 名'), ('名', r'旗 25 / 名 (\d+) / 其の他 59', '10_kuchi', r'/ 名 (\d+) / 其の他'), ('其の他', r'其の他 (\d+) / 不能 12 ＝', '10_kuchi', r'其の他 (\d+) / 不能'), ('不能', r'不能 (\d+) ＝ 和', '10_kuchi', r'不能 (\d+) ＝'), ('和', r'＝ 和 (\d+)★', '10_kuchi', r'＝ 和 (\d+) ='),
 ('R0', r'其の他:小文字\((\d+)\)', '10_kuchi', r'R0 (\d+)'), ('R2', r'→ 閾\((\d+)\)/ R3', '10_kuchi', r'R2 (\d+)'), ('R4', r'→ 名\((\d+)= path', '10_kuchi', r'R4 (\d+)'), ('R6b', r'R6b 含む語\(名 (\d+)\)', '10_kuchi', r'R6b (\d+)'), ('R7', r'R7 不能 (\d+)', '10_kuchi', r'R7 (\d+)'),
 ('重なり 10', r'両方在る重なり (\d+)\)', '10_kuchi', r'名へ落とした\) (\d+)'), ('fix_flag', r'fix_flag の番人口 (\d+) は 493 の外', '10_kuchi', r'番人口 fix_flag (\d+)\('),
