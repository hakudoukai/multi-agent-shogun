   local sz last1 last2
-  sz=$(wc -c < "$f" 2>/dev/null | tr -d ' ')
+  sz=$(safe_size "$f")
   if ! is_num "$sz"; then
     say "★條④ 測れぬ(寸法が取れぬ・出目「${sz}」) ―― ${f}★ ★測れぬは通さぬ(default-deny)★"
