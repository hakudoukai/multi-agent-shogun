      "lines": [
        {
          "speaker": "narrator",
          "text": "パパきょうりゅうが うなずきました。"
        },
        {
          "speaker": "papa_dino",
          "text": "たべたもので、からだが できる",
          "voice": "川は、山の水が あつまって できる。きみたちの からだも おなじだ。たべたものが、あつまって、きみの 歯や ほねに なる"
        }
      ],
      "effects": [
        {
          "type": "transition",
