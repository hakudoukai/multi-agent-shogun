      "actors": [
        {
          "id": "koron",
          "pose": "crouch",
          "anim": "idle",
          "position": "left"
        },
        {
          "id": "hana",
          "pose": "stand",
          "anim": "idle",
          "position": "right"
        }
      ],
      "lines": [
        {
          "speaker": "narrator",
          "text": "きらきらかわのみずは、いつもより"
        },
        {
          "speaker": "narrator",
          "text": "つめたい。"
        },
        {
          "speaker": "koron",
          "text": "このかわ、どこから きてるんだろう",
          "choices": [
            {
              "label": "やまから",
              "text": "やまから きたのかも。"
            },
            {
              "label": "うみから",
              "text": "うみから きたのかな。"
            }
          ]
        },
        {
          "speaker": "narrator",
          "text": "みずに てを つけた",
          "voice": "コロンちゃんが みずに てを つけて いいました"
        },
        {
          "speaker": "narrator",
          "text": "ハナちゃんが きづく",
          "voice": "そのとき ハナちゃんが なにかに きづきました"
        },
        {
          "speaker": "narrator",
          "text": "うえを ゆびさす",
          "voice": "ハナちゃんが うえを ゆびさします"
        },
        {
          "speaker": "hana",
          "text": "やまのほう、だれも しらない",
          "voice": "あっちの 山のほう。だれも いったこと ないんだって"
        }
      ],
      "effects": [
        {
