      ],
      "lines": [
        {
          "speaker": "narrator",
          "text": "きみは かわのみずを"
        },
        {
          "speaker": "narrator",
          "text": "すくって みました。てのひらの なかで"
        },
        {
          "speaker": "narrator",
          "text": "、みずが きらきら ひかっています。",
          "choices": [
            {
              "label": "すくう",
              "text": "みずが つめたい。"
            },
            {
              "label": "みるだけ",
              "text": "みずが きらきら する。"
            }
          ]
        },
        {
          "speaker": "narrator",
          "text": "このみずも、いつか だれかの ちからに"
        },
        {
          "speaker": "narrator",
          "text": "なるのかな。"
        }
      ],
