########## _utsushi/hei_watchdog.sh (行=40) ##########
--- 定義乙: ${NAME:-既定} の出現箇所 一覧(行番/名/演算子/既定/逐語) ---
L23   VAR                                op=:- 既定='default'
        逐語: # ★cycle4 Q1 fix: ${VAR:-default} 形で外部 override 可能化 (smoke test stub 用)★
L24   ER_PANE_TARGET                     op=:- 既定='commander-third:0.0'
        逐語: export ER_PANE_TARGET="${ER_PANE_TARGET:-commander-third:0.0}"
L25   ER_SESSION_NAME                    op=:- 既定='commander-third'
        逐語: export ER_SESSION_NAME="${ER_SESSION_NAME:-commander-third}"
L26   ER_FROM_PC_FILTER                  op=:- 既定='commander'
        逐語: export ER_FROM_PC_FILTER="${ER_FROM_PC_FILTER:-commander}"
L27   ER_LOG_DIR                         op=:- 既定='/home/hakudoukai/.local/share/enter_restart_commander'
        逐語: export ER_LOG_DIR="${ER_LOG_DIR:-/home/hakudoukai/.local/share/enter_restart_commander}"
L28   ER_EVENT_TYPE                      op=:- 既定='enter_restart_commander_fire'
        逐語: export ER_EVENT_TYPE="${ER_EVENT_TYPE:-enter_restart_commander_fire}"
