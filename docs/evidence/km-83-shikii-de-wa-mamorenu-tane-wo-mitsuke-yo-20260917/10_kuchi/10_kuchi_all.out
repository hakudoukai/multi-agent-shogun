        逐語: export ER_HEARTBEAT_TOPIC_PREFIX="${ER_HEARTBEAT_TOPIC_PREFIX:-[enter_restart] commander alive}"
L32   ER_CYCLE_LOG_PREFIX                op=:- 既定='enter_restart_commander'
        逐語: export ER_CYCLE_LOG_PREFIX="${ER_CYCLE_LOG_PREFIX:-enter_restart_commander}"
L35   ER_THRESHOLD_MIN                   op=:- 既定='2'
        逐語: export ER_THRESHOLD_MIN="${ER_THRESHOLD_MIN:-2}"
